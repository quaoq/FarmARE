digraph farm_dcore_neutral_modules {
  rankdir=LR;
  "field_preparation" [label="Field preparation"];
  "planting" [label="Planting readiness and execution"];
  "establishment" [label="Establishment monitoring"];
  "r1_monitoring" [label="R1 monitoring"];
  "mid_diagnosis" [label="Initial disease diagnosis"];
  "mid_treatment" [label="Initial treatment and response"];
  "r5_recheck" [label="R5 recurrence, recheck, and treatment"];
  "harvest_readiness" [label="Harvest readiness"];
  "harvest_execution" [label="Harvest and unloading"];
  "drying_storage" [label="Drying and storage"];
  "field_preparation" -> "planting" [style=dashed,label="phase progression"];
  "planting" -> "establishment" [style=dashed,label="phase progression"];
  "establishment" -> "r1_monitoring" [style=dashed,label="phase progression"];
  "r1_monitoring" -> "mid_diagnosis" [style=dashed,label="phase progression"];
  "mid_diagnosis" -> "mid_treatment" [style=dashed,label="phase progression"];
  "mid_treatment" -> "r5_recheck" [style=dashed,label="phase progression"];
  "r5_recheck" -> "harvest_readiness" [style=dashed,label="phase progression"];
  "harvest_readiness" -> "harvest_execution" [style=dashed,label="phase progression"];
  "harvest_execution" -> "drying_storage" [style=dashed,label="phase progression"];
}
